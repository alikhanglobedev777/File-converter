PORT=5000
MONGO_URI="mongodb+srv://<db_username>:<db_password>@<cluster_host>/?retryWrites=true&w=majority"
MONGO_DB_NAME=file_converter
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
CONVERT_RATE_LIMIT=30
CONVERT_RATE_WINDOW_MS=600000
CONVERT_CONCURRENCY_LIMIT=2
CONVERT_TIMEOUT_MS=90000
HISTORY_RETENTION_DAYS=30

# Configure a Gmail-connected EmailJS service/template and enable non-browser API requests.
# To Email field in EmailJS template: {{to_email}}
# Template body must contain {{reset_code}}, not an old {{reset_link}} button.
# Never put the private key in VITE_ variables.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
